# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
! .yarn/patches
! .yarn/plugins
! .yarn/releases
! .yarn/versions

# Next.js build output
.next/
out/
build/

# Python virtual environment and caching
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# Local databases and models
backend/faip.db
backend/trained_models/

# OS files
.DS_Store
Thumbs.db

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment files — keep .env.example, exclude all real secrets
.env
.env.local
.env.*.local
.env.development
.env.production

# Allow example templates to be committed
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ML model artifacts (large binary files)
backend/trained_models/*.pkl
backend/trained_models/*.joblib
backend/trained_models/*.h5
