# Backend environment variables
# Copy this file to .env (never commit .env)

# Database — leave blank for local SQLite.
# On Railway: auto-injected when you add the Postgres addon.
DATABASE_URL=

# CORS — comma-separated list of allowed frontend origins.
# On Railway: set this to your Vercel URL, e.g. https://faip.vercel.app
# Locally: leave blank to allow all origins.
ALLOWED_ORIGINS=
